{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  //
  // All tasks delegate to godot/tools/build.py — single source of truth
  // for scons flag combinations.
  "version": "2.0.0",
  "tasks": [
      {
          "label": "build",
          "group": "build",
          "type": "shell",
          "command": "python",
          "args": ["tools/build.py", "launcher"],
          "problemMatcher": "$msCompile"
      },
      {
          "label": "build renderer",
          "group": "build",
          "type": "shell",
          "command": "python",
          "args": ["tools/build.py", "renderer"],
          "problemMatcher": "$msCompile"
      },
      {
          "label": "build (template_release)",
          "group": "build",
          "type": "shell",
          "command": "python",
          "args": ["tools/build.py", "launcher-release"],
          "problemMatcher": "$msCompile"
      },
      {
          "label": "build renderer (template_release)",
          "group": "build",
          "type": "shell",
          "command": "python",
          "args": ["tools/build.py", "renderer-release"],
          "problemMatcher": "$msCompile"
      },
      {
          "label": "build (template_release, mac intel)",
          "group": "build",
          "type": "shell",
          "command": "python",
          "args": ["tools/build.py", "launcher-release", "--mac-intel"],
          "problemMatcher": "$msCompile"
      },
      {
          "label": "build renderer (template_release, mac intel)",
          "group": "build",
          "type": "shell",
          "command": "python",
          "args": ["tools/build.py", "renderer-release", "--mac-intel"],
          "problemMatcher": "$msCompile"
      }
  ]
}
