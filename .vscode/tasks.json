{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
      {
          "label": "build",
          "group": "build",
          "type": "shell",
          "command": "scons",
          "args": [
            "dev_build=yes", "tg_renderer=no", "compiledb=yes", "use_llvm=yes", "linker=lld", "disable_exceptions=no"
          ],
          "problemMatcher": "$msCompile"
      },
      {
          "label": "build renderer",
          "group": "build",
          "type": "shell",
          "command": "scons",
          "args": [
            "dev_build=yes", "target=template_debug", "tg_renderer=yes", "compiledb=yes", "use_llvm=yes", "linker=lld", "disable_exceptions=no"
          ],
          "problemMatcher": "$msCompile"
      },
      {
          "label": "build (template_release)",
          "group": "build",
          "type": "shell",
          "command": "scons",
          "args": [
            "production=yes", "tools=no", "target=template_release", "optimize=speed", "tg_renderer=no", "disable_exceptions=no"
          ],
          "problemMatcher": "$msCompile"
      },
      {
          "label": "build renderer (template_release)",
          "group": "build",
          "type": "shell",
          "command": "scons",
          "args": [
            "production=yes", "tools=no", "target=template_release", "optimize=speed", "tg_renderer=yes", "disable_exceptions=no"
          ],
          "problemMatcher": "$msCompile"
      },
      {
          "label": "build (template_release, x86_64)",
          "group": "build",
          "type": "shell",
          "command": "scons",
          "args": [
            "-j", "$(nproc)", "production=yes", "tools=no", "target=template_release", "optimize=speed", "tg_renderer=no", "disable_exceptions=no", "arch=x86_64"
          ],
          "problemMatcher": "$msCompile"
      },
      {
          "label": "build renderer (template_release, x86_64)",
          "group": "build",
          "type": "shell",
          "command": "scons",
          "args": [
            "-j", "$(nproc)", "production=yes", "tools=no", "target=template_release", "optimize=speed", "tg_renderer=yes", "disable_exceptions=no", "arch=x86_64"
          ],
          "problemMatcher": "$msCompile"
      }
  ]
}
