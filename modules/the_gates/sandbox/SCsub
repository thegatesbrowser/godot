#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_tg")

env_sandbox = env_tg.Clone()

module_obj = []

env_sandbox.add_source_files(module_obj, "*.cpp")

env.modules_sources += module_obj

# Add module-specific compiler flags. Chromium's base/ headers (transitively
# pulled in by sandbox headers) use C++20 concepts and require-clauses, so
# this module needs c++20. Godot itself stays on c++17.
# Strip any earlier /std:c++ flag the engine prepended, then append c++20
# (clang-cl uses the last /std flag on the command line).
env_sandbox["CXXFLAGS"] = [f for f in env_sandbox["CXXFLAGS"] if not str(f).startswith("/std:c++")]
env_sandbox.Append(CXXFLAGS=[
    "/std:c++20",
    "/DUNICODE",
    "/D_UNICODE",
])

# Disable chromium debugging code
env_sandbox.Prepend(CPPDEFINES=["NDEBUG"])

# Cross-exe broker/target operation. The vendored sandbox lib was built with
# SANDBOX_EXPORTS=1 (see the SANDBOX_EXPORTS-style patch in our chromium
# fork at sandbox/win/src/sandbox_types.h), so our wrapper TU must expand
# SANDBOX_INTERCEPT to the same dllexport form.
env_sandbox.Prepend(CPPDEFINES=["SANDBOX_EXPORTS=1"])
