#!/usr/bin/env python

Import("env")
Import("env_tg")

env_sandbox = env_tg.Clone()

module_obj = []

env_sandbox.add_source_files(module_obj, "*.cpp")

env.modules_sources += module_obj

# Add module-specific compiler flags
env_sandbox.Prepend(CXXFLAGS=[
    '/DUNICODE',              # Unicode for our module
    '/D_UNICODE'              # Unicode for our module
])

# Disable chromium debugging code
env_sandbox.Prepend(CPPDEFINES=["NDEBUG"])
