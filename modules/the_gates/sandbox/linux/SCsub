#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_tg")

env_linux = env_tg.Clone()
env_linux.Prepend(
    CPPPATH=[
        "#thirdparty/chromium-sandbox/chromium-shim",
        "#thirdparty/chromium-sandbox",
        "#thirdparty/chromium-sandbox/gen",
        "#thirdparty/chromium-sandbox/base/allocator/partition_allocator/src",
        "#thirdparty/chromium-sandbox/gen/base/allocator/partition_allocator/src",
        "#thirdparty/chromium-sandbox/third_party/abseil-cpp",
    ]
)
# Chromium headers (raw_ptr, location, scoped_generic, etc.) require C++20.
# Strip Godot's -std=c++17 default and append c++20; clang picks the last flag.
env_linux["CXXFLAGS"] = [f for f in env_linux["CXXFLAGS"] if not str(f).startswith("-std=")]
env_linux.Append(CXXFLAGS=["-std=c++20"])

module_obj = []
env_linux.add_source_files(module_obj, "*.cpp")

# Vendored Chromium sandbox sources, Firefox-style — build directly under
# SCons rather than linking a prebuilt library. The vendored snapshot lives
# at thirdparty/chromium-sandbox/; see thirdparty/chromium-sandbox/README.md
# for the pinned upstream and the list of files Firefox's moz.yaml takes.
#
# Two trees compiled together:
#   sandbox/linux/          — chromium's bpf_dsl, seccomp-bpf, helpers,
#                              minimal services subset.
#   base/                   — chromium base/ subset (POSIX flavor).
#   chromium-shim/          — Firefox's replacement layer that terminates
#                              the dep graph at logging, file_path, file_util.

env_sandbox = env_tg.Clone()

# Chromium uses C++20; Godot stays on C++17 for its own TUs. RTTI is kept on
# (chromium itself builds -fno-rtti, but our module files inherit from
# bpf_dsl::Policy and need its typeinfo at link time).
env_sandbox["CXXFLAGS"] = [f for f in env_sandbox["CXXFLAGS"] if not str(f).startswith("-std=")]
env_sandbox.Append(CXXFLAGS=["-std=c++20"])

# CPPDEFINES matching Chromium's ninja config for the sandbox lib (Linux).
env_sandbox.Prepend(
    CPPDEFINES=[
        "NDEBUG",
        "_GNU_SOURCE",
        ("_FILE_OFFSET_BITS", 64),
        ("_LARGEFILE_SOURCE", 1),
        ("_LARGEFILE64_SOURCE", 1),
        "NVALGRIND",
        ("DYNAMIC_ANNOTATIONS_ENABLED", 0),
        # Match Firefox's chromium-shim gates; chromium's logging.cc reads these.
        "MOZ_SANDBOX",
        "CHROMIUM_SANDBOX_BUILD",
    ]
)

env_sandbox.Prepend(
    CPPPATH=[
        "#thirdparty/chromium-sandbox/chromium-shim",
        "#thirdparty/chromium-sandbox",
        "#thirdparty/chromium-sandbox/gen",
        "#thirdparty/chromium-sandbox/base/allocator/partition_allocator/src",
        "#thirdparty/chromium-sandbox/gen/base/allocator/partition_allocator/src",
        "#thirdparty/chromium-sandbox/third_party/abseil-cpp",
    ]
)

# Vendored code we don't own — suppress its warnings.
env_sandbox.Append(
    CXXFLAGS=[
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
        "-Wno-unused-private-field",
        "-Wno-sign-compare",
        "-Wno-sign-conversion",
        "-Wno-deprecated-declarations",
        "-Wno-pragma-pack",
        "-Wno-ignored-attributes",
        "-Wno-invalid-offsetof",
    ]
)

vendor_dir = "#thirdparty/chromium-sandbox/"

# Mirror Firefox's moz.yaml `individual-files-list` for sandbox/linux/.
# Firefox skips sandbox_bpf.cc / baseline_policy.cc / sigsys_handlers.cc /
# syscall_parameters_restrictions.cc / syscall_sets.cc / thread_helpers.cc
# because their broker code drives the filter directly through the DSL +
# PolicyCompiler. Our `lockdown.cpp` follows the same shape so we vendor the
# same minimal subset.
sandbox_linux_sources = [
    "sandbox/linux/bpf_dsl/bpf_dsl.cc",
    "sandbox/linux/bpf_dsl/codegen.cc",
    "sandbox/linux/bpf_dsl/dump_bpf.cc",
    "sandbox/linux/bpf_dsl/policy.cc",
    "sandbox/linux/bpf_dsl/policy_compiler.cc",
    "sandbox/linux/bpf_dsl/syscall_set.cc",
    "sandbox/linux/bpf_dsl/verifier.cc",
    "sandbox/linux/seccomp-bpf/die.cc",
    "sandbox/linux/seccomp-bpf/syscall.cc",
    "sandbox/linux/seccomp-bpf/trap.cc",
    "sandbox/linux/services/syscall_wrappers.cc",
]

# base/ subset — POSIX flavor of what Windows already compiles.
base_sources = [
    "base/at_exit.cc",
    "base/check.cc",
    "base/check_op.cc",
    "base/cpu.cc",
    "base/debug/alias.cc",
    "base/debug/crash_logging.cc",
    "base/environment.cc",
    "base/functional/callback_internal.cc",
    "base/hash/hash.cc",
    "base/lazy_instance_helpers.cc",
    "base/location.cc",
    "base/memory/ref_counted.cc",
    "base/posix/safe_strerror.cc",
    "base/rand_util.cc",
    "base/strings/safe_sprintf.cc",
    "base/strings/string_number_conversions.cc",
    "base/strings/string_split.cc",
    "base/strings/string_util.cc",
    "base/strings/string_util_constants.cc",
    "base/strings/stringprintf.cc",
    "base/strings/utf_ostream_operators.cc",
    "base/strings/utf_string_conversion_utils.cc",
    "base/strings/utf_string_conversions.cc",
    "base/synchronization/lock.cc",
    "base/synchronization/lock_impl_posix.cc",
    "base/third_party/cityhash/city.cc",
    "base/third_party/superfasthash/superfasthash.c",
    "base/third_party/nspr/prtime.cc",
    "base/third_party/double_conversion/double-conversion/bignum-dtoa.cc",
    "base/third_party/double_conversion/double-conversion/bignum.cc",
    "base/third_party/double_conversion/double-conversion/cached-powers.cc",
    "base/third_party/double_conversion/double-conversion/double-to-string.cc",
    "base/third_party/double_conversion/double-conversion/fast-dtoa.cc",
    "base/third_party/double_conversion/double-conversion/fixed-dtoa.cc",
    "base/third_party/double_conversion/double-conversion/string-to-double.cc",
    "base/third_party/double_conversion/double-conversion/strtod.cc",
    "base/threading/platform_thread.cc",
    "base/threading/platform_thread_internal_posix.cc",
    "base/threading/platform_thread_posix.cc",
    "base/threading/platform_thread_ref.cc",
    "base/threading/thread_collision_warner.cc",
    "base/threading/thread_id_name_manager.cc",
    "base/threading/thread_local_storage.cc",
    "base/threading/thread_local_storage_posix.cc",
    "base/threading/thread_restrictions.cc",
    "base/time/time.cc",
    "base/time/time_now_posix.cc",
    "base/trace_event/trace_event_stub.cc",
    "base/version.cc",
]

# chromium-shim/ — Firefox-style minimal replacements that terminate
# the dep graph. The shim's logging.cpp is Windows-flavored; for Linux we
# provide our own logging stub under modules/the_gates/sandbox/linux/.
chromium_shim_sources = [
    "chromium-shim/base/logging_posix.cpp",
    "chromium-shim/base/files/file_path.cpp",
    "chromium-shim/base/debug/dump_without_crashing.cpp",
    "chromium-shim/base/debug/stack_trace.cpp",
    "chromium-shim/base/threading/platform_thread_linux.cpp",
]

# abseil str_format + base internals chromium transitively uses.
abseil_sources = [
    "third_party/abseil-cpp/absl/base/internal/raw_logging.cc",
    "third_party/abseil-cpp/absl/base/internal/throw_delegate.cc",
    "third_party/abseil-cpp/absl/numeric/int128.cc",
    "third_party/abseil-cpp/absl/strings/ascii.cc",
    "third_party/abseil-cpp/absl/strings/internal/escaping.cc",
    "third_party/abseil-cpp/absl/strings/internal/ostringstream.cc",
    "third_party/abseil-cpp/absl/strings/internal/utf8.cc",
    "third_party/abseil-cpp/absl/strings/internal/str_format/arg.cc",
    "third_party/abseil-cpp/absl/strings/internal/str_format/bind.cc",
    "third_party/abseil-cpp/absl/strings/internal/str_format/extension.cc",
    "third_party/abseil-cpp/absl/strings/internal/str_format/float_conversion.cc",
    "third_party/abseil-cpp/absl/strings/internal/str_format/output.cc",
    "third_party/abseil-cpp/absl/strings/internal/str_format/parser.cc",
    "third_party/abseil-cpp/absl/strings/internal/charconv_bigint.cc",
    "third_party/abseil-cpp/absl/strings/internal/charconv_parse.cc",
    "third_party/abseil-cpp/absl/strings/internal/memutil.cc",
    "third_party/abseil-cpp/absl/strings/internal/stringify_sink.cc",
    "third_party/abseil-cpp/absl/strings/string_view.cc",
    "third_party/abseil-cpp/absl/strings/charconv.cc",
    "third_party/abseil-cpp/absl/strings/escaping.cc",
    "third_party/abseil-cpp/absl/strings/match.cc",
    "third_party/abseil-cpp/absl/strings/numbers.cc",
    "third_party/abseil-cpp/absl/strings/str_cat.cc",
    "third_party/abseil-cpp/absl/strings/str_replace.cc",
    "third_party/abseil-cpp/absl/strings/str_split.cc",
    "third_party/abseil-cpp/absl/strings/substitute.cc",
]

thirdparty_sources = [
    vendor_dir + p for p in (sandbox_linux_sources + base_sources + chromium_shim_sources + abseil_sources)
]

env_thirdparty = env_sandbox.Clone()
env_thirdparty.disable_warnings()

thirdparty_obj = []
env_thirdparty.add_source_files(thirdparty_obj, thirdparty_sources)

env.modules_sources += module_obj
env.modules_sources += thirdparty_obj

# BoringSSL SHA-NI assembly. Runtime CPUID gate lives in sha256_file.cpp;
# pre-Ice-Lake Intel / pre-Zen AMD fall back to Godot's mbedtls SHA-256.
env_shaext = env_tg.Clone()
env_shaext.disable_warnings()

shaext_obj = []
env_shaext.add_source_files(shaext_obj, ["#thirdparty/sha256_shaext/sha256_ni-x86_64.S"])
env.modules_sources += shaext_obj
env.Depends(module_obj, shaext_obj)

env.Depends(module_obj, thirdparty_obj)
