chromium_shim_sandbox_sources = [
    # Firefox's logging wrapper for the sandbox.
    "chromium-shim/sandbox/win/sandboxLogging.cpp",
    # NOTE: chromium 137 re-added registry brokering upstream (with a new
    # 3-arg GenerateRules API that takes RegistrySemantics). Firefox's
    # shim's registry_*.cc files predate this and have the old 2-arg API,
    # so we use chromium's vendored versions instead. Already in
    # sandbox_win_sources above. Shim files removed from disk to avoid
    # CPPPATH header shadowing.
    # NOTE: line_break_* is a Firefox-specific feature for IDN line-break
