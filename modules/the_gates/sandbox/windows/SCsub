# ---------------------------------------------------------------------------
# chromium-shim — Firefox's replacement layer. Compiled INSTEAD of the
# corresponding chromium .cc files. The shim terminates the dep graph at
# logging, FilePath, RegKey, WinUtil, StackTrace, FileVersionInfo.
# ---------------------------------------------------------------------------
