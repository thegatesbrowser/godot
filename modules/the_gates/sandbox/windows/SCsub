#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_tg")

env_sandbox = env_tg.Clone()

module_obj = []

env_sandbox.add_source_files(module_obj, "*.cpp")

# Vendored Chromium sandbox sources, Firefox-style — build directly under
# SCons instead of linking the prebuilt cef_sandbox.lib.
#
# Two trees compiled together:
#   thirdparty/chromium-sandbox/                — Chromium snapshot, list
#                                                 curated per Firefox's
#                                                 security/sandbox/chromium/moz.yaml
#                                                 individual-files-list.
#   thirdparty/chromium-sandbox/chromium-shim/  — Firefox's shim that REPLACES
#                                                 chromium .cc files (logging,
#                                                 file_path, win_util,
#                                                 stack_trace, file_version_info)
#                                                 with minimal versions that
#                                                 terminate the dep graph
#                                                 instead of pulling in absl,
#                                                 mojom, perfetto, ICU,
#                                                 BoringSSL transitively.
#
# CPPPATH order matters: shim/ first, then sandbox/. That makes
# #include "base/win/registry.h" resolve to the shim's header (header-only,
# inline-define) rather than the chromium-vendored one.
#
# See notes/Sandboxing/Vendoring Option.md for the architecture and
# notes/Sandboxing/Agent Session 2026-05-14.md for the SANDBOX_EXPORTS patch
# (already applied to vendored sandbox/win/src/ files).

# Chromium uses C++20; Godot stays on C++17 for its own TUs. Strip any
# earlier /std:c++ flag the engine prepended, then append c++20 (clang-cl
# uses the last /std flag on the command line).
env_sandbox["CXXFLAGS"] = [f for f in env_sandbox["CXXFLAGS"] if not str(f).startswith("/std:c++")]
env_sandbox["CCFLAGS"] = [f for f in env_sandbox["CCFLAGS"] if not str(f).startswith("/std:c++")]
env_sandbox.Append(CXXFLAGS=[
    "/std:c++20",
    "/GR-",          # no RTTI — Chromium builds with -fno-rtti
])

# CPPDEFINES that match Chromium's ninja config for the sandbox lib
# (gleaned from out/Release_GN_x64_sandbox/obj/sandbox/win/sandbox.ninja).
env_sandbox.Prepend(CPPDEFINES=[
    "NDEBUG",
    ("SANDBOX_EXPORTS", 1),
    "UNICODE",
    "_UNICODE",
    "WIN32_LEAN_AND_MEAN",
    "NOMINMAX",
    ("WINVER", "0x0A00"),
    ("_WIN32_WINNT", "0x0A00"),
    ("NTDDI_VERSION", "NTDDI_WIN11_GE"),
    ("PSAPI_VERSION", 2),
    "_CRT_NONSTDC_NO_WARNINGS",
    "_WINSOCK_DEPRECATED_NO_WARNINGS",
    ("_HAS_EXCEPTIONS", 0),
    "_CRT_RAND_S",
    "_CRT_SECURE_NO_DEPRECATE",
    "_SCL_SECURE_NO_DEPRECATE",
    "_HAS_NODISCARD",
    "_WINDOWS",
    "_SECURE_ATL",
    "_ATL_NO_OPENGL",
    "WIN32",
    ("WINAPI_FAMILY", "WINAPI_FAMILY_DESKTOP_APP"),
    "CERT_CHAIN_PARA_HAS_EXTRA_FIELDS",
    "NVALGRIND",
    ("DYNAMIC_ANNOTATIONS_ENABLED", 0),
    # Firefox-style: tell logging.cc to skip its rust_logger include
    # (we don't link a rust loglet) and to take the chromium-shim's
    # MOZ_NO_MOZALLOC path. We're not Mozilla but the shim's #ifdef
    # gates match what we want.
    "MOZ_SANDBOX",
    "CHROMIUM_SANDBOX_BUILD",
    # Chromium 137 added a per-target buildflag for command-line sequence
    # checks normally injected via `defines` in base/BUILD.gn (no generated
    # header). Define it to 0 here so command_line.h's BUILDFLAG evaluates.
    # (USE_RUNTIME_VLOG is provided by chromium-shim/base/logging_buildflags.h.)
    "BUILDFLAG_INTERNAL_ENABLE_COMMANDLINE_SEQUENCE_CHECKS()=(0)",
])

env_sandbox.Prepend(CPPPATH=[
    # Order matters: shim shadows chromium for headers Firefox replaces.
    "#thirdparty/chromium-sandbox/chromium-shim",
    "#thirdparty/chromium-sandbox",
    "#thirdparty/chromium-sandbox/gen",
    "#thirdparty/chromium-sandbox/base/allocator/partition_allocator/src",
    "#thirdparty/chromium-sandbox/gen/base/allocator/partition_allocator/src",
    # The shim's third_party/abseil-cpp/*.h files are forwarders that
    # include "absl/...". Resolve those to our vendored abseil headers.
    "#thirdparty/chromium-sandbox/third_party/abseil-cpp",
])

# Suppress warnings — vendored code we don't own.
env_sandbox.Append(CXXFLAGS=[
    "-Wno-unused-parameter",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-unused-private-field",
    "-Wno-sign-compare",
    "-Wno-sign-conversion",
    "-Wno-shorten-64-to-32",
    "-Wno-deprecated-declarations",
    "-Wno-nonportable-include-path",
    "-Wno-microsoft-cast",
    "-Wno-microsoft-enum-value",
    "-Wno-c++20-compat",
    "-Wno-pragma-pack",
    "-Wno-ignored-attributes",
    "-Wno-invalid-offsetof",
])

vendor_dir = "#thirdparty/chromium-sandbox/"

